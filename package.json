{
    "name": "okastr8",
    "module": "main.ts",
    "type": "module",
    "private": true,
    "scripts": {
        "build": "bun build src/main.ts --outdir=build --target=node",
        "lint": "eslint src scripts test *.ts",
        "lint:fix": "eslint src scripts test *.ts --fix",
        "format": "prettier . --write",
        "format:check": "prettier . --check",
        "typecheck": "tsc --noEmit -p tsconfig.check.json",
        "check": "bun run lint && bun run typecheck && bun run format:check",
        "test": "bun run test:unit && bun run test:smoke",
        "test:unit": "bun test test/unit",
        "test:smoke": "bun test test/smoke",
        "test:integration": "bun test test/integration",
        "test:e2e": "playwright test",
        "gate:prod": "bash scripts/dev/prod-gate.sh",
        "gate:prod:no-e2e": "RUN_E2E=0 bash scripts/dev/prod-gate.sh",
        "gate:prod:no-scan": "RUN_SCANNERS=0 bash scripts/dev/prod-gate.sh"
    },
    "devDependencies": {
        "@eslint/js": "^10.0.1",
        "@playwright/test": "^1.60.0",
        "@types/bun": "^1.3.14",
        "eslint": "^10.3.0",
        "eslint-config-prettier": "^10.1.8",
        "globals": "^17.6.0",
        "prettier": "^3.8.3",
        "typescript-eslint": "^8.59.3"
    },
    "peerDependencies": {
        "typescript": "^6.0.3"
    },
    "overrides": {
        "flatted": "^3.4.0",
        "picomatch": "^4.0.4"
    },
    "dependencies": {
        "@types/js-yaml": "^4.0.9",
        "commander": "^14.0.3",
        "enquirer": "^2.4.1",
        "hono": "^4.12.18",
        "js-yaml": "^4.1.1",
        "ora": "^9.4.0",
        "yaml": "^2.9.0"
    }
}
