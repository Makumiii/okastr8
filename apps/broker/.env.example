# Okastr8 Broker - Environment Variables
# These must be set in your Convex Dashboard for the Broker to function.
# For local development with 'npx convex dev', you can place these in a .env.local 
# file in the apps/broker/convex directory (note: convex uses its own dashboard for secrets).

# --- GitHub App Credentials ---
# Found in GitHub Developer Settings > GitHub Apps > [Your App] > General
GITHUB_APP_ID="123456"
GITHUB_CLIENT_ID="Iv23..."
GITHUB_CLIENT_SECRET="a623..."

# --- Webhook Security ---
# This must match the 'Secret' you entered in the GitHub App Webhook section.
# Generate one with: openssl rand -hex 32
GITHUB_WEBHOOK_SECRET="your_webhook_secret_here"

# --- Private Key ---
# Generate this at the bottom of the GitHub App General page.
# Paste the ENTIRE content of the .pem file, including the BEGIN and END lines.
# If using a .env file locally, you may need to replace newlines with \n.
GITHUB_PRIVATE_KEY="-----BEGIN RSA PRIVATE KEY-----\n...\n-----END RSA PRIVATE KEY-----"

# --- Frontend Configuration ---
# The URL where the Broker's Next.js frontend is hosted.
# Used for OAuth redirects.
FRONTEND_URL="http://localhost:3000"

# --- Convex Specifics ---
# Public URL for the Convex deployment (used by the Manager to connect)
NEXT_PUBLIC_CONVEX_URL="https://your-deployment-name.convex.cloud"
