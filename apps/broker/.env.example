# Okastr8 Broker - Environment Variables
#
# Grouped by where each value is configured:
# 1. Convex side: secrets and backend settings stored in Convex.
# 2. Next.js on Vercel: public frontend values used by the browser app.
#
# The extra Convex dev-only values at the bottom are written by `npx convex dev`
# and are not required for the deployed app itself.

# --- 1) Convex side ---
# Set these in the Convex Dashboard / Convex environment for the Broker backend.

# GitHub App credentials
# Found in GitHub Developer Settings > GitHub Apps > [Your App] > General
GITHUB_APP_ID="123456"
GITHUB_CLIENT_ID="Iv23..."
GITHUB_CLIENT_SECRET="a623..."

# Webhook security
# Must match the Secret you set in the GitHub App Webhook section.
# Generate one with: openssl rand -hex 32
GITHUB_WEBHOOK_SECRET="your_webhook_secret_here"

# GitHub App private key
# Generate this at the bottom of the GitHub App General page.
# Paste the ENTIRE content of the .pem file, including the BEGIN and END lines.
# If using a .env file locally, you may need to replace newlines with \n.
GITHUB_PRIVATE_KEY="-----BEGIN RSA PRIVATE KEY-----\n...\n-----END RSA PRIVATE KEY-----"

# --- 2) Next.js on Vercel ---
# Set these in your Vercel project environment variables for the Next.js app.

# The URL where the Broker frontend is hosted.
# Used for OAuth redirects back to the app.
FRONTEND_URL="http://localhost:3000"

# Public Convex deployment URL used by the browser client.
# This is the value the Next.js app reads at runtime.
NEXT_PUBLIC_CONVEX_URL="https://your-deployment-name.convex.cloud"

# --- Local Convex dev only ---
# These are usually written automatically by `npx convex dev`.
# Keep them in your local .env.local if you use Convex locally.

# Deployment identifier for the local Convex dev workflow.
CONVEX_DEPLOYMENT="dev:rapid-wolf-687"

# Public site URL for the local Convex deployment.
NEXT_PUBLIC_CONVEX_SITE_URL="https://rapid-wolf-687.convex.site"
